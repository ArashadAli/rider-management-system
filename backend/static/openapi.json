  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT Authorization header using Bearer scheme. Enter token without 'Bearer ' prefix."
      },
      "CsrfHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CSRF-TOKEN",
        "description": "CSRF Token for state-changing requests when cookies are used"
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Unauthorized - Missing or invalid JWT token",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "success": { "type": "boolean", "example": false },
                "message": { "type": "string", "example": "Unauthorized" }
              }
            }
          }
        }
      },
      "BadRequest": {
        "description": "Bad Request - Validation failed",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "success": { "type": "boolean", "example": false },
                "message": { "type": "string", "example": "Validation error" },
                "errors": { "type": "object" }
              }
            }
          }
        }
      },
      "NotFound": {
        "description": "Resource not found",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "success": { "type": "boolean", "example": false },
                "message": { "type": "string", "example": "Resource not found" }
              }
            }
          }
        }
      }
    },
    "schemas": {
      "ApiResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "message": { "type": "string" }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": false },
          "message": { "type": "string" },
          "errors": { "type": "object" }
        }
      },
      "RegisterRequest": {
        "type": "object",
        "required": ["name", "email", "mobile", "password", "confirm_password"],
        "properties": {
          "name": { "type": "string", "example": "John Doe" },
          "email": { "type": "string", "format": "email", "example": "john@example.com" },
          "mobile": { "type": "string", "pattern": "^[6-9]\\d{9}$", "example": "9876543210" },
          "password": { "type": "string", "minLength": 8, "example": "SecretPass123" },
          "confirm_password": { "type": "string", "example": "SecretPass123" }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string", "format": "email", "example": "john@example.com" },
          "password": { "type": "string", "example": "SecretPass123" }
        }
      },
      "UserProfileUpdate": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "example": "John Doe Updated" },
          "mobile": { "type": "string", "pattern": "^[6-9]\\d{9}$", "example": "9876543210" },
          "profile_image": { "type": "string", "format": "binary", "description": "Profile picture (JPEG, PNG)" }
        }
      },
      "ChangePasswordRequest": {
        "type": "object",
        "required": ["currentPassword", "newPassword"],
        "properties": {
          "currentPassword": { "type": "string", "example": "OldSecret123" },
          "newPassword": { "type": "string", "minLength": 8, "example": "NewSecret456" }
        }
      },
      "RiderCreateRequest": {
        "type": "object",
        "required": ["name", "email", "mobile", "vehicle_type", "vehicle_number"],
        "properties": {
          "name": { "type": "string", "example": "Alex Rider" },
          "email": { "type": "string", "format": "email", "example": "alex@rider.com" },
          "mobile": { "type": "string", "pattern": "^[6-9]\\d{9}$", "example": "9123456780" },
          "vehicle_type": { "type": "string", "example": "Motorcycle" },
          "vehicle_number": { "type": "string", "example": "KA-01-AB-1234" },
          "status": { "type": "string", "enum": ["active", "inactive"], "default": "active" },
          "availability": { "type": "string", "enum": ["available", "unavailable"], "default": "available" },
          "profile_image": { "type": "string", "format": "binary", "description": "Rider photo" }
        }
      },
      "RiderUpdateRequest": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "example": "Alex Rider Updated" },
          "email": { "type": "string", "format": "email", "example": "alex_new@rider.com" },
          "mobile": { "type": "string", "pattern": "^[6-9]\\d{9}$", "example": "9123456780" },
          "vehicle_type": { "type": "string", "example": "Electric Scooter" },
          "vehicle_number": { "type": "string", "example": "KA-01-XY-9999" },
          "status": { "type": "string", "enum": ["active", "inactive"] },
          "availability": { "type": "string", "enum": ["available", "unavailable", "busy"] },
          "profile_image": { "type": "string", "format": "binary" }
        }
      },
      "OrderCreateRequest": {
        "type": "object",
        "required": ["order_item", "customer_name", "customer_mobile", "pickup_address", "delivery_address", "amount"],
        "properties": {
          "order_item": { "type": "string", "example": "Pizza Margherita x 2" },
          "customer_name": { "type": "string", "example": "Alice Smith" },
          "customer_mobile": { "type": "string", "pattern": "^\\d{10}$", "example": "9876543210" },
          "pickup_address": { "type": "string", "example": "123 Main St, Bakery Corner" },
          "delivery_address": { "type": "string", "example": "456 Oak Avenue, Apt 4B" },
          "amount": { "type": "number", "minimum": 0.01, "example": 299.50 }
        }
      },
      "OrderStatusUpdateRequest": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": {
            "type": "string",
            "enum": ["created", "assigned", "accepted", "picked_up", "on_the_way", "delivered", "cancelled"],
            "example": "accepted"
          },
          "cancellation_reason": {
            "type": "string",
            "maxLength": 500,
            "description": "Required when status is 'cancelled'.",
            "example": "Customer requested cancellation"
          }
        }
      },
      "OrderAssignRiderRequest": {
        "type": "object",
        "required": ["rider_id"],
        "properties": {
          "rider_id": { "type": "string", "example": "3fa85f64-5717-4562-b3fc-2c963f66afa6" }
        }
      }
    }
  }
}